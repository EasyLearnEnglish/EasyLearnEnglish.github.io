    <!-- Landing Page: About Me Section -->
    <section id="about">
        <div class="container hero-grid">
            <div class="hero-content">
                <h1>Hi, I'm Ben. <br>Your Personal English Tutor.</h1>
                <p>I help non-native speakers gain natural confidence, refine their pronunciation, and master conversational fluency for career advancement and everyday life.</p>
                <a href="#schedule" class="cta-btn">Start Learning Today</a>
            </div>
            
            <!-- Space reserved for Profile Photo -->
            <div class="profile-photo-wrapper">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=800" alt="Ben - Online English Tutor Profile Photo" class="profile-photo">
            </div>
        </div>
    </section>

    <!-- Extra Stylish Photos Section on About Me Page -->
    <section class="gallery-section">
        <div class="container">
            <h2 class="section-title">Teaching Style & Journey</h2>
            <p>A closer look at my interactive virtual classroom and tailored learning approaches.</p>
            
            <div class="gallery-grid">
                <!-- Additional Photo 1 -->
                <div class="gallery-item">
                    <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=600" alt="Interactive Online Teaching Session" class="gallery-photo">
                    <div class="gallery-caption">
                        <h3>Interactive Live Lessons</h3>
                        <p>Real-time collaboration using customized digital materials tailored directly to your specific goals and interests.</p>
                    </div>
                </div>

                <!-- Additional Photo 2 -->
                <div class="gallery-item">
