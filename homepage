                    <div class="gallery-caption">
                        <h3>Cultural & Conversational Depth</h3>
                        <p>Learn idioms, business etiquette, and natural expressions that go far beyond standard textbook English.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container footer-grid">
            <div class="footer-brand">
                <h4>Ben's English Studio</h4>
                <p>Empowering global voices through conversational mastery and confidence.</p>
            </div>
            <div class="footer-links">
                <h5>Navigation</h5>
                <ul>
                    <li><a href="#about">About Me</a></li>
                    <li><a href="#why-learn">Why Learn with Ben?</a></li>
                    <li><a href="#blog">Blog</a></li>
                </ul>
            </div>
            <div class="footer-links">
                <h5>Bookings</h5>
                <ul>
                    <li><a href="#schedule">Schedule a Lesson</a></li>
